# ============================================================
# 环境变量模板（此文件可提交，只放占位值，禁止写入真实凭据）
# 用法：cp .env.example .env  然后填入真实值
# 真实 .env 已被 .gitignore 排除，仅保存在本地
# ============================================================

PORT=5443
HOST=0.0.0.0
NODE_ENV=production

# JWT 签名密钥（必填）
# 生成方式：openssl rand -hex 32
# 不要复用示例值，不要提交真实值
JWT_SECRET=CHANGE_ME__run_openssl_rand_hex_32

# ============================================================
# 大模型接入（OpenAI 兼容协议）
# 真实地址与密钥只写本地 .env，禁止提交、禁止写入前端代码
# ============================================================
# 网关地址（示例为模板占位，按部署环境填写）
LLM_BASE_URL=http://127.0.0.1:8090/v1/deepseek
# 访问密钥
LLM_API_KEY=CHANGE_ME
# 模型名
LLM_MODEL=deepseek-v4-flash
# 单次调用超时（毫秒）
LLM_TIMEOUT_MS=60000

# ============================================================
# 数据仓库 MCP（可选）
# 不配置时智能体仅用本地 Prisma 工具；配置后智能体可查演示样本
# 之外的全量数据（历史年报、招投标、处罚等）
# ============================================================
# MCP 查询服务地址
MCP_DORIS_URL=
# 认证信息（按服务端要求填写）
MCP_DORIS_AUTH=
# 单次查询超时（毫秒）；深度查询较慢，建议 ≥20000
MCP_TIMEOUT_MS=28000

# ============================================================
# Cloudflare 隧道（可选，仅公网演示需要）
# token 等价于域名接管凭据：只写本地 .env，禁止提交；
# 启动时优先用 --token-file / 环境变量注入，勿写进命令行参数
# ============================================================
# 固定域名
CF_TUNNEL_DOMAIN=
# 隧道 ID
CF_TUNNEL_ID=
# 隧道 token
CF_TUNNEL_TOKEN=
