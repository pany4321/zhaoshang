# ============================================================
# 环境变量模板（此文件可提交，只放占位值，禁止写入真实凭据）
# 用法：cp .env.example .env  然后填入真实值
# 真实 .env 已被 .gitignore 排除，仅保存在本地
# ============================================================

PORT=5443
HOST=0.0.0.0
NODE_ENV=production

# JWT 签名密钥（必填）
# 生成方式：openssl rand -hex 32
# 不要复用示例值，不要提交真实值
JWT_SECRET=CHANGE_ME__run_openssl_rand_hex_32

# ============================================================
# 大模型接入（OpenAI 兼容协议）
# 真实地址与密钥只写本地 .env，禁止提交、禁止写入前端代码
# ============================================================
# 网关地址（示例为模板占位，按部署环境填写）
LLM_BASE_URL=http://127.0.0.1:8090/v1/deepseek
# 访问密钥
LLM_API_KEY=CHANGE_ME
# 模型名
LLM_MODEL=deepseek-v4-flash
# 单次调用超时（毫秒）
LLM_TIMEOUT_MS=60000
